# Copy these settings into the production host's secret/environment settings.
# Replace every placeholder. Never commit real production values.
NODE_ENV=production
HOST=0.0.0.0
# Render provides PORT for the web service; leave it unset in the dashboard.
TRUST_PROXY=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
COOKIE_SECURE=true
APP_BASE_URL=https://YOUR_PUBLIC_DOMAIN
APP_ENCRYPTION_KEY=GENERATE_A_UNIQUE_BASE64_32_BYTE_KEY
RATE_LIMIT_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# SMTP credentials are required for password recovery and email alerts.
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=RootCause <alerts@YOUR_DOMAIN>

# Use this HTTPS provider on Render Free, which blocks outbound SMTP ports.
# Owner-only smoke test: EMAIL_FROM=RootCause <onboarding@resend.dev>.
# For messages to all users, verify a domain in Resend and use that sender.
RESEND_API_KEY=
EMAIL_FROM=RootCause <alerts@YOUR_DOMAIN>

# Optional AI explanations for logs without a built-in rule. Groq takes priority.
# Logs are redacted first. Review the provider's data-use terms before enabling.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Billing stays disabled until Razorpay plans, secrets and webhook are tested.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Monthly Plus Razorpay plan ID; configure the matching amount/frequency in Razorpay.
RAZORPAY_PLAN_ID_TEAM=

# Optional GitHub profile connection. Configure this callback URL in the GitHub OAuth app:
# https://YOUR_PUBLIC_DOMAIN/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
