NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
# Neon pooled connection string; verify the server certificate and hostname.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
COOKIE_SECURE=false
# Generate a base64 32-byte encryption key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Generate a separate random value, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Optional email alerts (TLS SMTP).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RootCause <alerts@example.com>
# HTTPS email API (works on Render Free); set both values to enable it.
RESEND_API_KEY=
EMAIL_FROM=RootCause <alerts@example.com>
# Optional AI fallback for unmatched logs. Groq takes priority if both keys are set.
# Logs are redacted first; free provider plans may have their own data-use terms.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional Razorpay Plus subscription; use test keys first. Billing stays disabled until setup is tested.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay monthly Plus plan (currently ₹199/month).
RAZORPAY_PLAN_ID_TEAM=

# Canonical public origin used in password-reset emails (HTTPS in production).
APP_BASE_URL=http://127.0.0.1:3000

# Optional GitHub account linking for the profile menu. Set the OAuth app callback to:
# https://YOUR_PUBLIC_DOMAIN/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
