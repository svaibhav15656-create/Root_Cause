NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
# Neon pooled connection string; verify the server certificate and hostname.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
COOKIE_SECURE=false
# Generate a base64 32-byte encryption key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Generate a separate random value, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Optional email alerts (TLS SMTP).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RootCause <alerts@example.com>
# HTTPS email API (works on Render Free); set both values to enable it.
RESEND_API_KEY=
EMAIL_FROM=RootCause <alerts@example.com>
# Optional plain-English LLM fallback; logs are redacted before leaving this server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional Razorpay subscriptions; start with test keys. Keep billing disabled until ready.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_TEAM=

# Canonical public origin used in password-reset emails (HTTPS in production).
APP_BASE_URL=http://127.0.0.1:3000
